378: vec3 m_moon_disc(vec3 m_d, vec3 m_m, out float m_mask)
379: 	{
380: 		float m_c=dot(m_d, m_m);
381: 		float m_ang=acos(clamp(m_c, -1.0, 1.0));
382: 		m_mask=(1.0 - smoothstep((m_moon_radius * 0.95999997854233), m_moon_radius, m_ang));
383: 		if ((m_mask <= 0.0))
384: 		{
385: 					{
386: return vec3(0.0,0.0,0.0);		}
387: ;
388: 		}
389: 		vec3 m_right=normalize(cross(vec3(0.0,1.0,0.0), m_m));
390: 		vec3 m_up=cross(m_m, m_right);
391: 		vec2 m_q=(vec2(dot(m_d, m_right), dot(m_d, m_up)) / sin(m_moon_radius));
392: 		float m_r2=dot(m_q, m_q);
393: 		float m_z=sqrt(max(0.0, (1.0 - m_r2)));
394: 		float m_lon=atan(m_q.x, m_z);
395: 		float m_lat=asin(clamp(m_q.y, -1.0, 1.0));
396: 		vec2 m_uv=vec2((0.5 + (m_lon / 6.28318530717959)), (0.5 - (m_lat / 3.14159265358979)));
397: 		vec3 m_albedo=texture(m_moon_texture, m_uv).rgb;
398: 		float m_limb=mix(0.55000001192093, 1.0, pow(m_z, 0.44999998807907));
399: return ((((m_albedo * m_limb) * m_moon_tint) * m_moon_energy) * 1.60000002384186);	}
