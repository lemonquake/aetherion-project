405: float m_night_stars(vec3 m_d, float m_px)
406: 	{
407: 		vec3 m_m=normalize(m_moon_direction);
408: 		float m_total=0.0;
409: 		for (int m_i=0;(m_i < m_star_count);m_i++)
410: 		{
411: 					{
412: 			float m_fi=float(m_i);
413: 			float m_h=m_hash11(((m_fi * 1.37000000476837) + 0.5));
414: 			float m_az=((m_fi * 2.39996004104614) + ((m_hash11((m_fi + 7.09999990463257)) - 0.5) * 0.89999997615814));
415: 			float m_el=asin(mix(0.34000000357628, 0.98000001907349, m_hash11(((m_fi * 3.09999990463257) + 2.0))));
416: 			vec3 m_s=vec3((cos(m_el) * sin(m_az)), sin(m_el), (cos(m_el) * cos(m_az)));
417: 			if ((dot(m_s, m_m) > 0.93000000715256))
418: 			{
419: 							{
420: 				m_s=vec3(-m_s.x, m_s.y, -m_s.z);
421: 			}
422: ;
423: 			}
424: 			float m_ang=length((m_d - m_s));
425: 			if ((m_ang > (m_px * 6.0)))
426: 			{
427: 							{
428: continue;			}
429: ;
430: 			}
431: 			float m_brightness=mix(0.30000001192093, 1.0, pow(m_hash11(((m_fi * 5.30000019073486) + 1.10000002384186)), 2.0));
432: 			float m_twinkle=(0.86000001430511 + ((0.14000000059605 * sin(((time * (1.10000002384186 + (m_h * 2.29999995231628))) + (m_h * 40.0)))) * sin(((time * (0.37000000476837 + (m_h * 0.60000002384186))) + m_fi))));
433: 			float m_core=exp(-pow((m_ang / (m_px * 0.85000002384186)), 2.0));
434: 			float m_glow=((exp(-pow((m_ang / (m_px * 2.59999990463257)), 2.0)) * 0.11999999731779) * m_brightness);
435: 			m_total+=(((m_core + m_glow) * m_brightness) * m_twinkle);
436: 		}
437: ;
438: 		}
439: return m_total;	}
