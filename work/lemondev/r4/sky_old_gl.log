116: // allenwp tonemapping curve; developed for use in the Godot game engine.
117: // Source and details: https://allenwp.com/blog/2025/05/29/allenwp-tonemapping-curve/
118: // Input must be a non-negative linear scene value.
119: vec3 allenwp_curve(vec3 x) {
120: 	const float output_max_value = 1.0; // SDR always has an output_max_value of 1.0
121: 
122: 	// These constants must match the those in the C++ code that calculates the parameters.
123: 	// 18% "middle gray" is perceptually 50% of the brightness of reference white.
124: 	const float awp_crossover_point = 0.18;
125: 	// When output_max_value and/or awp_crossover_point are no longer constant,
126: 	// awp_shoulder_max can be calculated on the CPU and passed in as tonemap_e.
127: 	const float awp_shoulder_max = output_max_value - awp_crossover_point;
128: 
129: 	float awp_contrast = tonemapper_params.x;
130: 	float awp_toe_a = tonemapper_params.y;
131: 	float awp_slope = tonemapper_params.z;
132: 	float awp_w = tonemapper_params.w;
133: 
134: 	// Reinhard-like shoulder:
135: 	vec3 s = x - awp_crossover_point;
136: 	vec3 slope_s = awp_slope * s;
137: 	s = slope_s * (1.0 + s / awp_w) / (1.0 + (slope_s / awp_shoulder_max));
138: 	s += awp_crossover_point;
139: 
140: 	// Sigmoid power function toe:
141: 	vec3 t = pow(x, vec3(awp_contrast));
142: 	t = t / (t + awp_toe_a);
143: 
144: 	return mix(s, t, lessThan(x, vec3(awp_crossover_point)));
145: }
