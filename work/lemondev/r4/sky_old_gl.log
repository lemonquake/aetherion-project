204: #define TONEMAPPER_LINEAR 0
205: #define TONEMAPPER_REINHARD 1
206: #define TONEMAPPER_FILMIC 2
207: #define TONEMAPPER_ACES 3
208: #define TONEMAPPER_AGX 4
209: 
210: vec3 apply_tonemapping(vec3 color) { // inputs are LINEAR
211: 	if (tonemapper == TONEMAPPER_LINEAR) {
212: 		return color;
213: 	}
214: 
215: 	// Ensure color values passed to tonemappers are positive.
216: 	// They can be negative in the case of negative lights, which leads to undesired behavior.
217: 	color = max(vec3(0.0), color);
218: 
219: 	if (tonemapper == TONEMAPPER_REINHARD) {
220: 		return tonemap_reinhard(color);
221: 	} else if (tonemapper == TONEMAPPER_FILMIC) {
222: 		return tonemap_filmic(color);
223: 	} else if (tonemapper == TONEMAPPER_ACES) {
224: 		return tonemap_aces(color);
225: 	} else { // TONEMAPPER_AGX
226: 		return tonemap_agx(color);
227: 	}
228: }
