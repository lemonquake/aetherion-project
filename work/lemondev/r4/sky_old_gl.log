87: // Adapted from https://github.com/TheRealMJP/BakingLab/blob/master/BakingLab/ACES.hlsl
88: // (MIT License).
89: vec3 tonemap_aces(vec3 color) {
90: 	// These constants must match the those in the C++ code that calculates the parameters.
91: 	const float exposure_bias = 1.8f;
92: 	const float A = 0.0245786f;
93: 	const float B = 0.000090537f;
94: 	const float C = 0.983729f;
95: 	const float D = 0.432951f;
96: 	const float E = 0.238081f;
97: 
98: 	// Exposure bias baked into transform to save shader instructions. Equivalent to `color *= exposure_bias`
99: 	const mat3 rgb_to_rrt = mat3(
100: 			vec3(0.59719f * exposure_bias, 0.35458f * exposure_bias, 0.04823f * exposure_bias),
101: 			vec3(0.07600f * exposure_bias, 0.90834f * exposure_bias, 0.01566f * exposure_bias),
102: 			vec3(0.02840f * exposure_bias, 0.13383f * exposure_bias, 0.83777f * exposure_bias));
103: 
104: 	const mat3 odt_to_rgb = mat3(
105: 			vec3(1.60475f, -0.53108f, -0.07367f),
106: 			vec3(-0.10208f, 1.10813f, -0.00605f),
107: 			vec3(-0.00327f, -0.07276f, 1.07602f));
108: 
109: 	color *= rgb_to_rrt;
110: 	vec3 color_tonemapped = (color * (color + A) - B) / (color * (C * color + D) + E);
111: 	color_tonemapped *= odt_to_rgb;
112: 
113: 	return color_tonemapped / tonemapper_params.x;
114: }
