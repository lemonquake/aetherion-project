321: vec4 m_clouds(vec3 m_d, vec3 m_m, float m_up, out float m_thick)
322: 	{
323: 		vec2 m_plane=(m_d.xz / (m_up + 0.11999999731779));
324: 		vec2 m_drift=((normalize(m_cloud_direction) * time) * m_cloud_speed);
325: 		vec2 m_uv=((m_plane * m_cloud_scale) + m_drift);
326: 		vec2 m_evolve=(vec2(sin((time * 0.0109999999404)), cos((time * 0.00899999961257))) * 0.05000000074506);
327: 		vec2 m_warp=((texture(m_cloud_noise, ((m_uv * 0.5) + m_evolve)).bb - 0.5) * 0.07000000029802);
328: 		float m_base=texture(m_cloud_noise, (m_uv + m_warp)).r;
329: 		float m_second=texture(m_cloud_noise, (((m_uv * 0.40999999642372) + vec2(0.23000000417233,0.37000000476837)) - m_evolve)).r;
330: 		float m_n=((m_base * 0.60000002384186) + (m_second * 0.40000000596046));
331: 		float m_threshold=(1.0 - m_cloud_cover);
332: 		float m_cover=smoothstep(m_threshold, (m_threshold + m_cloud_softness), m_n);
333: 		float m_detail=texture(m_cloud_noise, (((m_uv * 2.29999995231628) + m_warp) + m_evolve)).g;
334: 		m_cover*=mix(1.0, smoothstep(0.15000000596046, 0.85000002384186, m_detail), (0.44999998807907 * (1.0 - m_cover)));
335: 		float m_thickness=smoothstep(m_threshold, (m_threshold + (m_cloud_softness * 3.0)), m_n);
336: 		m_thick=m_thickness;
337: 		m_cover*=smoothstep(0.03999999910593, 0.30000001192093, m_up);
338: 		float m_mc=max(dot(m_d, m_m), 0.0);
339: 		float m_scatter=(((pow(m_mc, 6.0) * 0.44999998807907) + (pow(m_mc, 50.0) * 1.20000004768372)) + (pow(m_mc, 600.0) * 2.0));
340: 		vec3 m_col=mix(m_cloud_lit, m_cloud_dark, (m_thickness * 0.75));
341: 		m_col+=((m_halo_color * m_scatter) * mix(1.0, 0.34999999403954, m_thickness));
342: 		vec2 m_hd=normalize((m_d.xz + vec2(0.00009999999747,0.00009999999747)));
343: 		m_col+=(((m_city_glow * 0.60000002384186) * pow(max(dot(m_hd, normalize(m_city_dir)), 0.0), 2.0)) * (1.0 - smoothstep(0.05000000074506, 0.5, m_up)));
344: 		m_col=mix((m_horizon_color * 0.89999997615814), m_col, smoothstep(0.01999999955297, 0.34999999403954, m_up));
345: return vec4(m_col, (m_cover * 0.9200000166893));	}
