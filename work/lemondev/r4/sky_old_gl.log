536: void main() {
537: 	vec3 cube_normal;
538: #ifdef USE_MULTIVIEW
539: 	// In multiview our projection matrices will contain positional and rotational offsets that we need to properly unproject.
540: 	vec4 unproject = vec4(uv_interp.xy, -1.0, 1.0); // unproject at the far plane
541: 	vec4 unprojected = multiview_data.inv_projection_matrix_view[ViewIndex] * unproject;
542: 	cube_normal = unprojected.xyz / unprojected.w;
543: 
544: 	// Unproject will give us the position between the eyes, need to re-offset.
545: 	cube_normal += multiview_data.eye_offset[ViewIndex].xyz;
546: #else
547: 	cube_normal.z = -1.0;
548: 	cube_normal.x = (uv_interp.x + projection.x) / projection.y;
549: 	cube_normal.y = (uv_interp.y + projection.z) / projection.w;
550: #endif
551: 	cube_normal = mat3(orientation) * cube_normal;
552: 	cube_normal = normalize(cube_normal);
553: 
