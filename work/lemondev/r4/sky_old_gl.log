510: // Eberly approximations from https://seblagarde.wordpress.com/2014/12/01/inverse-trigonometric-functions-gpu-optimization-for-amd-gcn-architecture/.
511: // input [-1, 1] and output [0, PI]
512: float acos_approx(float p_x) {
513: 	float x = abs(p_x);
514: 	float res = -0.156583f * x + (M_PI / 2.0);
515: 	res *= sqrt(1.0f - x);
516: 	return (p_x >= 0.0) ? res : M_PI - res;
517: }
518: 
519: // Based on https://math.stackexchange.com/questions/1098487/atan2-faster-approximation
520: // but using the Eberly coefficients from https://seblagarde.wordpress.com/2014/12/01/inverse-trigonometric-functions-gpu-optimization-for-amd-gcn-architecture/.
521: float atan2_approx(float y, float x) {
522: 	float a = min(abs(x), abs(y)) / max(abs(x), abs(y));
523: 	float s = a * a;
524: 	float poly = 0.0872929f;
525: 	poly = -0.301895f + poly * s;
526: 	poly = 1.0f + poly * s;
527: 	poly = poly * a;
528: 
529: 	float r = abs(y) > abs(x) ? (M_PI / 2.0) - poly : poly;
530: 	r = x < 0.0 ? M_PI - r : r;
531: 	r = y < 0.0 ? -r : r;
532: 
533: 	return r;
534: }
