69: vec3 tonemap_filmic(vec3 color) {
70: 	// These constants must match the those in the C++ code that calculates the parameters.
71: 	// exposure_bias: Input scale (color *= bias, env->white *= bias) to make the brightness consistent with other tonemappers.
72: 	// Also useful to scale the input to the range that the tonemapper is designed for (some require very high input values).
73: 	// Has no effect on the curve's general shape or visual properties.
74: 	const float exposure_bias = 2.0f;
75: 	const float A = 0.22f * exposure_bias * exposure_bias; // bias baked into constants for performance
76: 	const float B = 0.30f * exposure_bias;
77: 	const float C = 0.10f;
78: 	const float D = 0.20f;
79: 	const float E = 0.01f;
80: 	const float F = 0.30f;
81: 
82: 	vec3 color_tonemapped = ((color * (A * color + C * B) + D * E) / (color * (A * color + B) + D * F)) - E / F;
83: 
84: 	return color_tonemapped / tonemapper_params.x;
85: }
