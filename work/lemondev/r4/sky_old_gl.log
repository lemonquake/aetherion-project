492: vec4 fog_process(vec3 view, vec3 sky_color) {
493: 	vec3 fog_color = mix(fog_light_color.rgb, sky_color, fog_aerial_perspective);
494: 
495: 	if (fog_sun_scatter > 0.001) {
496: 		vec4 sun_scatter = vec4(0.0);
