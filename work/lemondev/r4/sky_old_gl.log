118: vec3 allenwp_curve(vec3 x) {
119: 	const float output_max_value = 1.0; // SDR always has an output_max_value of 1.0
120: 
121: 	// These constants must match the those in the C++ code that calculates the parameters.
122: 	// 18% "middle gray" is perceptually 50% of the brightness of reference white.
123: 	const float awp_crossover_point = 0.18;
124: 	// When output_max_value and/or awp_crossover_point are no longer constant,
125: 	// awp_shoulder_max can be calculated on the CPU and passed in as tonemap_e.
126: 	const float awp_shoulder_max = output_max_value - awp_crossover_point;
127: 
128: 	float awp_contrast = tonemapper_params.x;
129: 	float awp_toe_a = tonemapper_params.y;
130: 	float awp_slope = tonemapper_params.z;
131: 	float awp_w = tonemapper_params.w;
132: 
133: 	// Reinhard-like shoulder:
134: 	vec3 s = x - awp_crossover_point;
135: 	vec3 slope_s = awp_slope * s;
136: 	s = slope_s * (1.0 + s / awp_w) / (1.0 + (slope_s / awp_shoulder_max));
137: 	s += awp_crossover_point;
138: 
139: 	// Sigmoid power function toe:
140: 	vec3 t = pow(x, vec3(awp_contrast));
141: 	t = t / (t + awp_toe_a);
142: 
143: 	return mix(s, t, lessThan(x, vec3(awp_crossover_point)));
144: }
