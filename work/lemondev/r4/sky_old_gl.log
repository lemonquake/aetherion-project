347: vec3 m_day_sky(vec3 m_d, float m_up, vec4 m_cl, float m_thick)
348: 	{
349: 		vec3 m_s=normalize(m_sun_direction);
350: 		vec3 m_c=mix(m_day_horizon, m_day_zenith, smoothstep(-0.01999999955297, 0.60000002384186, m_up));
351: 		float m_sc=max(dot(m_d, m_s), 0.0);
352: 		m_c+=(m_sun_color * ((pow(m_sc, 6.0) * 0.18000000715256) + (pow(m_sc, 48.0) * 0.44999998807907)));
353: 		if ((m_up > 0.0))
354: 		{
355: 					{
356: 			vec3 m_cloud=(mix(vec3(0.93999999761581,0.93999999761581,0.94999998807907), vec3(0.5,0.52999997138977,0.5799999833107), (m_thick * 0.80000001192093)) + ((m_sun_color * pow(m_sc, 10.0)) * 0.40000000596046));
357: 			m_c=mix(m_c, m_cloud, (m_cl.a * 0.85000002384186));
358: 		}
359: ;
360: 		}
361: 		if (!AT_CUBEMAP_PASS)
362: 		{
363: 					{
364: 			float m_ang=acos(clamp(dot(m_d, m_s), -1.0, 1.0));
365: 			float m_core=(1.0 - smoothstep(0.01700000092387, 0.01999999955297, m_ang));
366: 			float m_ring=((1.0 - smoothstep(0.0, 0.00249999994412, abs((m_ang - 0.04699999839067)))) * 0.5);
367: 			vec3 m_r1=normalize(cross(m_s, vec3(0.0,0.0,1.0)));
368: 			vec3 m_r2=cross(m_s, m_r1);
369: 			float m_az=atan(dot(m_d, m_r2), dot(m_d, m_r1));
370: 			float m_spoke=smoothstep(0.46999999880791, 0.49500000476837, abs((fract(((m_az * 6.0) / 6.28318530717959)) - 0.5)));
371: 			float m_struts=(((m_spoke * step(0.01999999955297, m_ang)) * step(m_ang, 0.04699999839067)) * 0.34999999403954);
372: 			m_c+=(m_sun_color * (((m_core * 14.0) + (m_ring * 1.60000002384186)) + m_struts));
373: 		}
374: ;
375: 		}
