53: // This approximation expects non-negative input; negative input behaves poorly.
54: vec3 srgb_to_linear(vec3 color) {
55: 	// Approximation from http://chilliant.blogspot.com/2012/08/srgb-approximations-for-hlsl.html
56: 	return color * (color * (color * 0.305306011 + 0.682171111) + 0.012522878);
