509: // Eberly approximations from https://seblagarde.wordpress.com/2014/12/01/inverse-trigonometric-functions-gpu-optimization-for-amd-gcn-architecture/.
510: // input [-1, 1] and output [0, PI]
511: float acos_approx(float p_x) {
512: 	float x = abs(p_x);
513: 	float res = -0.156583f * x + (M_PI / 2.0);
514: 	res *= sqrt(1.0f - x);
515: 	return (p_x >= 0.0) ? res : M_PI - res;
516: }
517: 
518: // Based on https://math.stackexchange.com/questions/1098487/atan2-faster-approximation
519: // but using the Eberly coefficients from https://seblagarde.wordpress.com/2014/12/01/inverse-trigonometric-functions-gpu-optimization-for-amd-gcn-architecture/.
520: float atan2_approx(float y, float x) {
521: 	float a = min(abs(x), abs(y)) / max(abs(x), abs(y));
522: 	float s = a * a;
523: 	float poly = 0.0872929f;
524: 	poly = -0.301895f + poly * s;
525: 	poly = 1.0f + poly * s;
526: 	poly = poly * a;
527: 
528: 	float r = abs(y) > abs(x) ? (M_PI / 2.0) - poly : poly;
529: 	r = x < 0.0 ? M_PI - r : r;
530: 	r = y < 0.0 ? -r : r;
531: 
532: 	return r;
533: }
