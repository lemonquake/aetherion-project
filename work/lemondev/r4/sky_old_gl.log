155: 	// best to prevent negative input values.
156: 	// This is done before the Rec. 2020 transform to allow the Rec. 2020
157: 	// transform to be combined with the AgX inset matrix. This results in a loss
158: 	// of color information that could be correctly interpreted within the
159: 	// Rec. 2020 color space as positive RGB values, but is often not worth
160: 	// the performance cost of an additional matrix multiplication.
161: 	//
162: 	// Additionally, this AgX configuration was created subjectively based on
163: 	// output appearance in the Rec. 709 color gamut, so it is possible that these
164: 	// matrices will not perform well with non-Rec. 709 output (more testing with
165: 	// future wide-gamut displays is be needed).
166: 	// See this comment from the author on the decisions made to create the matrices:
167: 	// https://github.com/godotengine/godot-proposals/issues/12317#issuecomment-2835824250
168: 
169: 	// Combined Rec. 709 to Rec. 2020 and Blender AgX inset matrices:
170: 	const mat3 rec709_to_rec2020_agx_inset_matrix = mat3(
171: 			0.544814746488245, 0.140416948464053, 0.0888104196149096,
172: 			0.373787398372697, 0.754137554567394, 0.178871756420858,
173: 			0.0813978551390581, 0.105445496968552, 0.732317823964232);
174: 
175: 	// Combined inverse AgX outset matrix and Rec. 2020 to Rec. 709 matrices.
176: 	const mat3 agx_outset_rec2020_to_rec709_matrix = mat3(
177: 			1.96488741169489, -0.299313364904742, -0.164352742528393,
178: 			-0.855988495690215, 1.32639796461980, -0.238183969428088,
179: 			-0.108898916004672, -0.0270845997150571, 1.40253671195648);
