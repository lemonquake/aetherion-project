; Aetherion Project by Aljay Leodones
config_version=5

[application]

config/name="Aetherion Project by Aljay Leodones"
config/description="Multiplayer night-time survival battle royale set in a Philippine riverside slum."
config/version="0.7.0"
run/main_scene="res://src/core/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/ui/icon.svg"
boot_splash/bg_color=Color(0.02, 0.02, 0.025, 1)
boot_splash/show_image=false

[autoload]

Defs="*res://src/core/defs.gd"
Settings="*res://src/core/settings.gd"
Net="*res://src/net/net.gd"
Game="*res://src/core/game.gd"
SoundSys="*res://src/audio/sound_system.gd"
Profile="*res://src/online/profile.gd"
Online="*res://src/online/online.gd"

[audio]

general/3d_panning_strength=0.75
driver/enable_input=true

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_variable=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/unused_signal=0
gdscript/warnings/untyped_declaration=0
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/confusable_local_declaration=0
gdscript/warnings/inference_on_variant=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray()

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Characters"
3d_physics/layer_3="Props"
3d_physics/layer_4="Glass"
3d_physics/layer_5="Interactables"
3d_physics/layer_6="Water"
3d_physics/layer_7="Debris"
3d_physics/layer_8="Corpses"
3d_physics/layer_9="Foliage"
3d_physics/layer_10="ProjectileOnly"
3d_physics/layer_11="Blockers"
3d_render/layer_1="World"
3d_render/layer_2="Viewmodel"
3d_render/layer_3="LocalBody"
3d_render/layer_4="Characters"
3d_render/layer_5="Interior"
3d_render/layer_6="InteriorProps"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=6
common/max_physics_steps_per_frame.mobile=4
common/physics_interpolation=true
3d/physics_engine="Jolt Physics"
3d/default_linear_damp=0.05
3d/default_angular_damp=0.08
3d/sleep_threshold_linear=0.08
3d/sleep_threshold_angular=0.12
jolt_physics_3d/simulation/position_steps=3
jolt_physics_3d/simulation/penetration_slop=0.01
jolt_physics_3d/limits/max_angular_velocity=60.0
jolt_physics_3d/limits/max_linear_velocity=300.0
jolt_physics_3d/limits/max_bodies=65536
jolt_physics_3d/limits/max_body_pairs=65536
jolt_physics_3d/limits/max_contact_constraints=20480

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level.mobile=1
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/positional_shadow/atlas_size.mobile=2048
mesh_lod/lod_change/threshold_pixels.mobile=4.0
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/use_taa.mobile=false
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/atlas_quadrant_0_subdiv=1
lights_and_shadows/positional_shadow/atlas_quadrant_1_subdiv=2
lights_and_shadows/positional_shadow/atlas_quadrant_2_subdiv=3
lights_and_shadows/positional_shadow/atlas_quadrant_3_subdiv=3
environment/defaults/default_clear_color=Color(0.01, 0.012, 0.018, 1)
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
anti_aliasing/screen_space_roughness_limiter/enabled=true
occlusion_culling/use_occlusion_culling=true
mesh_lod/lod_change/threshold_pixels=2.0
limits/cluster_builder/max_clustered_elements=1024

[shader_globals]

wind_gust={
"type": "float",
"value": 0.0
}
zone_center={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
zone_radius={
"type": "float",
"value": 10000.0
}
