# Godot caches
game/.godot/
*.import.tmp
# Re-downloadable third-party assets (see tools/fetch_assets.py and docs/ASSET_MANIFEST.md)
game/assets/thirdparty/polyhaven/
tools/cache/
# Generated captures (selected ones are copied into docs/)
work/screens/
*.part
# Exported game builds (tools/write_export_presets.py)
builds/
__pycache__/
work/lemondev/r7/zf/
# (r27) regenerable Hidden Forest working files: raw candidate renders, the binary terrain draft
work/hf/raw/
work/hf/check/
work/hf/terrain_draft/*.f32
work/hf/terrain_draft/*.u32
work/hf/terrain_draft/cover.json
# Godot copies a GDExtension library to ~<name> while it is loaded (hot reload); never commit the copy
game/addons/terrain_3d/bin/~*
